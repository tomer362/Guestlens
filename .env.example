# Neon (Vercel Marketplace integration sets these automatically)
DATABASE_URL=postgres://...pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://.../neondb?sslmode=require
# Vercel Blob (created from the Storage tab)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# openssl rand -base64 32
JWT_SECRET=change-me
# Protects the /setup page (any long random string, 12+ chars)
SETUP_KEY=change-me-too
# Budget profile: hobby | pro | custom  (see lib/config.ts)
PLAN=hobby
# Optional overrides (bytes / counts)
# BUDGET_STORAGE_BYTES=
# BUDGET_PUTS=
# Send every diagnostics line to /api/diag (debugging only; costs function invocations)
# NEXT_PUBLIC_DIAG=1
# Max video upload in MB (default 60; raise on Pro)
# NEXT_PUBLIC_VIDEO_MAX_MB=60
